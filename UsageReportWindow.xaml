<Window x:Class="WindowsNetworkMonitor.UsageReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Usage Report" Height="450" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="White">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowBackground" Value="#252526"/>
            <Setter Property="AlternatingRowBackground" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <TabControl Background="Transparent" BorderThickness="0">
            <!-- Daily Report -->
            <TabItem Header="Daily">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Total Usage Today:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="DailyTotalText" Text="0 MB" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="DailyGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="*"/>
                            <DataGridTextColumn Header="Upload" Binding="{Binding Upload}" Width="*"/>
                            <DataGridTextColumn Header="Download" Binding="{Binding Download}" Width="*"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Monthly Report -->
            <TabItem Header="Monthly">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                     <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Total Usage This Month:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="MonthlyTotalText" Text="0 MB" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="MonthlyGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Month" Binding="{Binding Date}" Width="*"/>
                            <DataGridTextColumn Header="Upload" Binding="{Binding Upload}" Width="*"/>
                            <DataGridTextColumn Header="Download" Binding="{Binding Download}" Width="*"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Yearly Report -->
            <TabItem Header="Yearly">
                <Grid>
                     <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                     <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Total Usage This Year:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="YearlyTotalText" Text="0 MB" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="YearlyGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Year" Binding="{Binding Date}" Width="*"/>
                            <DataGridTextColumn Header="Upload" Binding="{Binding Upload}" Width="*"/>
                            <DataGridTextColumn Header="Download" Binding="{Binding Download}" Width="*"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Total Report -->
             <TabItem Header="Total">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Total Usage Ever Recorded" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Text="Upload:" Grid.Row="0" Grid.Column="0" Margin="0,0,10,5" FontSize="16"/>
                            <TextBlock x:Name="TotalUploadText" Text="0 GB" Grid.Row="0" Grid.Column="1" FontWeight="Bold" FontSize="16"/>
                            
                            <TextBlock Text="Download:" Grid.Row="1" Grid.Column="0" Margin="0,0,10,5" FontSize="16"/>
                            <TextBlock x:Name="TotalDownloadText" Text="0 GB" Grid.Row="1" Grid.Column="1" FontWeight="Bold" FontSize="16"/>

                            <Rectangle Height="1" Fill="Gray" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10"/>
                        </Grid>
                         <TextBlock x:Name="AllTimeTotalText" Text="0 GB" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>

                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
