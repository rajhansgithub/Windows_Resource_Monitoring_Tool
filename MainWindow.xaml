<Window x:Class="WindowsNetworkMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowsNetworkMonitor"
        mc:Ignorable="d"
    Title="NetworkMonitor" Height="Auto" Width="Auto"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#202020"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid Margin="5">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- CPU -->
            <StackPanel x:Name="CpuPanel" Orientation="Vertical" Margin="5,0,10,0" VerticalAlignment="Center">
                <TextBlock x:Name="CpuLoadText" Text="CPU: 0%" Foreground="#E0E0E0" FontSize="11" FontFamily="Segoe UI" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- GPU -->
            <StackPanel x:Name="GpuPanel" Orientation="Vertical" Margin="0,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="GPU: -" Foreground="#E0E0E0" FontSize="11" FontFamily="Segoe UI" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Network -->
            <StackPanel x:Name="NetworkPanel" Orientation="Vertical" Margin="0,0,10,0" VerticalAlignment="Center">
                <TextBlock x:Name="UploadText" Text="▲ 0.0 KB/s" Foreground="#E0E0E0" FontSize="11" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                <TextBlock x:Name="DownloadText" Text="▼ 0.0 KB/s" Foreground="#E0E0E0" FontSize="11" FontFamily="Segoe UI" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
