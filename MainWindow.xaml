<Window x:Class="WindowsNetworkMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowsNetworkMonitor"
        mc:Ignorable="d"
        Title="NetworkMonitor" Height="40" Width="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#202020"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid>
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
            <TextBlock x:Name="UploadText" Text="▲ 0.0 KB/s" Foreground="#E0E0E0" FontSize="11" FontFamily="Segoe UI" FontWeight="SemiBold"/>
            <TextBlock x:Name="DownloadText" Text="▼ 0.0 KB/s" Foreground="#E0E0E0" FontSize="11" FontFamily="Segoe UI" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
